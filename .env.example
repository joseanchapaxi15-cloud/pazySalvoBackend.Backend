# Copia este archivo como .env antes del despliegue y cambia las claves.
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-y-unica
BOOTSTRAP_ADMIN_USERNAME=talento.humano
BOOTSTRAP_ADMIN_FULL_NAME=Administrador de Talento Humano
BOOTSTRAP_ADMIN_EMAIL=talento.humano@institucion.gob.ec
BOOTSTRAP_ADMIN_PASSWORD=cambiar-esta-clave-inicial

# Gmail SMTP. MAIL_PASSWORD debe ser una contraseña de aplicación de Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=pega-aqui-la-contrasena-de-aplicacion
MAIL_FROM=tu-correo@gmail.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# Producción: solo activar detrás de un proxy HTTPS con certificado TLS válido.
# Reemplaza el dominio por el host HTTPS institucional; nunca uses IP/HTTP aquí.
# SPRING_PROFILES_ACTIVE=production
# CORS_ALLOWED_ORIGINS=https://pazysalvo.inamhi.gob.ec
